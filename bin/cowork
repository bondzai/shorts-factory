#!/usr/bin/env bash
# Hand this channel's queue to an agent, in this terminal.
#
# The prompt is rendered fresh every time from the database — this channel's
# rules, its recent clips, the hooks skill, your Directions — so an agent
# started today is never working from last week's brief.
#
#   bin/cowork              # Claude Code on the default channel
#   bin/cowork --channel x  # another channel
#   bin/cowork --print      # just print the prompt (paste it anywhere)
#   AGENT=codex bin/cowork  # a different agent
#   bin/cowork --unattended # Claude Code with the factory's MCP tools pre-approved
#                           # and nothing else: no shell, no file edits. For
#                           # working a queue while nobody is at the keyboard.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
factory="$here/.venv/bin/factory"
agent="${AGENT:-claude}"
channel=""
print_only=""
unattended=""

while [ $# -gt 0 ]; do
  case "$1" in
    --channel) channel="$2"; shift 2 ;;
    --print) print_only=1; shift ;;
    --unattended) unattended=1; shift ;;
    *) echo "usage: cowork [--channel ID] [--print]   (AGENT=claude|codex)" >&2; exit 2 ;;
  esac
done

[ -x "$factory" ] || { echo "no factory at $factory — is the venv built?" >&2; exit 1; }

# The flag belongs to the subcommand, not the program: `factory --channel x
# playbook work` is accepted and silently ignored, which handed both workers
# the default channel's prompt.
if [ -n "$channel" ]; then
  prompt="$("$factory" playbook work --channel "$channel")"
else
  prompt="$("$factory" playbook work)"
fi

if [ -n "$print_only" ]; then printf '%s\n' "$prompt"; exit 0; fi

command -v "$agent" >/dev/null 2>&1 || { echo "$agent is not on PATH. Try: AGENT=<other> $0, or --print and paste it." >&2; exit 1; }

cd "$here"
if [ -n "$unattended" ]; then
  # Only the factory's own MCP tools are pre-approved. Anything else the
  # agent reaches for still asks, which with nobody present means it waits.
  # The prompt goes first: --allowedTools takes every argument after it as
  # another tool name, and swallowed the whole prompt the first time.
  if [ "$agent" = "claude" ]; then
    # Only the factory's MCP server is loaded: without --strict-mcp-config
    # Claude Code brings every connector the operator has (Gmail, Drive, …)
    # and prints that they need signing in, on every run.
    mcp="{\"mcpServers\":{\"shorts-factory\":{\"command\":\"$factory\",\"args\":[\"mcp\"]}}}"
    exec "$agent" "$prompt" --allowedTools "mcp__shorts-factory" --strict-mcp-config --mcp-config "$mcp"
  fi
  exec "$agent" "$prompt" --allowedTools "mcp__shorts-factory"
fi
exec "$agent" "$prompt"
