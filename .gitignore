.venv/
data/*
!data/concepts/
__pycache__/
*.pyc
*.egg-info/
.env
# Both spellings: Google names the download client_secret_*.json
client_secret*.json
token.json
.pytest_cache/
# A channel's folder holds its OAuth token and the Analyst-edited rules.md,
# which stay on the machine. What a season needs is tracked: the cast, the
# scoring and the season files (docs/08).
/channels/*/*
!/channels/*/cast.toml
!/channels/*/scoring.toml
!/channels/*/season/

# Agent worktrees live here; they are checkouts, not content.
.claude/worktrees/
